# Database Configuration
# For local development, keep as defaults or change to your local PostgreSQL settings
# For production (Render), set these in the Environment Variables section
SPRING_DATASOURCE_URL=jdbc:postgresql://your-supabase-db-url:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-password

# Security Configuration
# Generate a long random string for JWT_SECRET
JWT_SECRET=your-very-long-secret-key-here
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
